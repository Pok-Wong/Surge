#!name=AI Services
#!desc=ChatGPT, Claude, Gemini, Perplexity。自动优选 US/SG/JP 节点，解决锁区问题。
#!system=mac

[Proxy Group]
AIGroup = url-test, policy-regex-filter=(?i)(美国|US|States|新加坡|SG|Singapore|日本|JP|Japan), interval=180, tolerance=50, timeout=3, url=http://www.gstatic.com/generate_204

[Rule]
# 1. OpenAI (ChatGPT)
DOMAIN-SUFFIX,chatgpt.com,AIGroup
DOMAIN-SUFFIX,openai.com,AIGroup
DOMAIN-SUFFIX,oaistatic.com,AIGroup
DOMAIN-SUFFIX,oaiusercontent.com,AIGroup
DOMAIN-SUFFIX,openaiapi-site.azureedge.net,AIGroup
DOMAIN-KEYWORD,openai,AIPremium

# 2. Anthropic (Claude)
DOMAIN-SUFFIX,claude.ai,AIGroup
DOMAIN-SUFFIX,anthropic.com,AIGroup
DOMAIN-SUFFIX,anthropicusercontent.com,AIGroup

# 3. Perplexity AI
DOMAIN-SUFFIX,perplexity.ai,AIGroup
DOMAIN-SUFFIX,pplx.ai,AIGroup

# 4. Google Gemini
DOMAIN-SUFFIX,gemini.google.com,AIGroup
DOMAIN-SUFFIX,bard.google.com,AIGroup
DOMAIN-SUFFIX,aistudio.google.com,AIGroup
DOMAIN-SUFFIX,alkalimakers.google.com,AIGroup
DOMAIN-SUFFIX,generativelanguage.googleapis.com,AIGroup
DOMAIN-SUFFIX,proactivetips-pa.googleapis.com,AIGroup
DOMAIN-SUFFIX,deepmind.google,AIGroup
DOMAIN-SUFFIX,deepmind.com,AIGroup
DOMAIN-SUFFIX,ogads-pa.clients6.google.com,AIGroup

# 5. 通用 Google 组件
DOMAIN-SUFFIX,googleusercontent.com,AIGroup
# DOMAIN-KEYWORD,google,AIGroup
