#!name=AI Services FINAL (ASCII Safe)
#!system=ios,mac

[Proxy Group]
# 策略组名称已简化，请在导入后手动编辑，替换占位符
# Placeholder 已经改成纯英文，以避免中文解析问题
AI_Premium = url-test, PlaceholderA, PlaceholderB, PlaceholderC, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50

[Rule]
# 1. OpenAI (ChatGPT)
DOMAIN-SUFFIX,chatgpt.com,AI_Premium
DOMAIN-SUFFIX,openai.com,AI_Premium
DOMAIN-SUFFIX,oaistatic.com,AI_Premium
DOMAIN-SUFFIX,oaiusercontent.com,AI_Premium
DOMAIN-SUFFIX,openaiapi-site.azureedge.net,AI_Premium
DOMAIN-KEYWORD,openai,AI_Premium

# 2. Anthropic (Claude)
DOMAIN-SUFFIX,claude.ai,AI_Premium
DOMAIN-SUFFIX,anthropic.com,AI_Premium
DOMAIN-SUFFIX,anthropicusercontent.com,AI_Premium

# 3. Perplexity AI
DOMAIN-SUFFIX,perplexity.ai,AI_Premium
DOMAIN-SUFFIX,pplx.ai,AI_Premium

# 4. Google Gemini
DOMAIN-SUFFIX,gemini.google.com,AI_Premium
DOMAIN-SUFFIX,bard.google.com,AI_Premium
DOMAIN-SUFFIX,aistudio.google.com,AI_Premium
DOMAIN-SUFFIX,alkalimakers.google.com,AI_Premium
DOMAIN-SUFFIX,generativelanguage.googleapis.com,AI_Premium
DOMAIN-SUFFIX,proactivetips-pa.googleapis.com,AI_Premium
DOMAIN-SUFFIX,deepmind.google,AI_Premium
DOMAIN-SUFFIX,deepmind.com,AI_Premium
DOMAIN-SUFFIX,ogads-pa.clients6.google.com,AI_Premium

# 5. 通用 Google 组件
DOMAIN-SUFFIX,googleusercontent.com,AI_Premium
